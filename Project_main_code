#include <Arduino.h>
#include <ESP8266WiFi.h>
#include <SPI.h>
#include <MFRC522.h>
#include <HTTPSRedirect.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// ---------------- LCD ----------------
LiquidCrystal_I2C lcd(0x27, 20, 4);

// ---------------- WiFi & Google Sheets ----------------
const char* ssid = "Your_hotspot_name";
const char* password = "Your_password";

const char* host = "script.google.com";
const int httpsPort = 443;
const char* GScriptId ="Your_GScriptID";

String url = String("/macros/s/") + GScriptId + "/exec";
String payload_base = "{\"command\":\"insert_row\",\"sheet_name\":\"Sheet1\",\"values\":";
String payload = "";

HTTPSRedirect* client = nullptr;

// ---------------- RFID ----------------
#define RST_PIN D3
#define SS_PIN  D4
#define BUZZER_PIN D0

MFRC522 mfrc522(SS_PIN, RST_PIN);
MFRC522::MIFARE_Key key;
MFRC522::StatusCode status;

int blocks[] = {4, 5, 6, 8, 9};
#define total_blocks (sizeof(blocks) / sizeof(blocks[0]))

byte bufferLen = 18;
byte readBlockData[18];

String student_id;
String student_name;
String father_name;
String student_class;
String serverResponse;

// ---------------- BUZZER ----------------
void beepOnce(int d = 100) {
  digitalWrite(BUZZER_PIN, HIGH);
  delay(d);
  digitalWrite(BUZZER_PIN, LOW);
}

void beepTwice() {
  for (int i = 0; i < 2; i++) {
    beepOnce(100);
    delay(100);
  }
}

void beepAlert() {
  for (int i = 0; i < 3; i++) {
    beepOnce(100);
    delay(100);
  }
}

// ---------------- CUSTOM SMILEY & SAD FACE ----------------
byte smiley[8] = {
  0b00000,
  0b01010,
  0b01010,
  0b00000,
  0b10001,
  0b01110,
  0b00000,
};

byte sad[8] = {
  0b00000,
  0b01010,
  0b01010,
  0b00000,
  0b01110,
  0b10001,
  0b00000,
};

// ---------------- SHOW SCAN SCREEN ----------------
void showScanScreen() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Scan Your Card");
}

// ---------------- RFID READ FUNCTION ----------------
void ReadDataFromBlock(int blockNum, byte readBlockData[]) {
  for (byte i = 0; i < 6; i++)
    key.keyByte[i] = 0xFF;

  status = mfrc522.PCD_Authenticate(
             MFRC522::PICC_CMD_MF_AUTH_KEY_A,
             blockNum,
             &key,
             &(mfrc522.uid)
           );

  if (status != MFRC522::STATUS_OK) return;

  status = mfrc522.MIFARE_Read(blockNum, readBlockData, &bufferLen);
  if (status != MFRC522::STATUS_OK) return;

  readBlockData[16] = ' ';
  readBlockData[17] = ' ';
}

// ---------------- SETUP ----------------
void setup() {
  Serial.begin(9600);
  SPI.begin();
  mfrc522.PCD_Init();

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  lcd.init();
  lcd.backlight();
  lcd.clear();

  // Create custom smiley and sad face
  lcd.createChar(0, smiley);
  lcd.createChar(1, sad);

  // WELCOME SCREEN
  lcd.setCursor(0, 1);
  lcd.print("  Welcome To Smart  ");
  lcd.setCursor(0, 2);
  lcd.print("  Attendance System ");
  lcd.setCursor(9, 3);
  lcd.write(byte(0));   // show smiley
  delay(3000);
  lcd.clear();

  // -------- WIFI CONNECTION --------
  lcd.setCursor(0, 0);
  lcd.print("Connecting WiFi...");
  WiFi.begin(ssid, password);

  int wifi_attempts = 0;
  const int max_attempts = 20; // ~10 seconds

  while (WiFi.status() != WL_CONNECTED && wifi_attempts < max_attempts) {
      delay(500);
      wifi_attempts++;
  }

  if (WiFi.status() == WL_CONNECTED) {
      lcd.setCursor(0, 1);
      lcd.print("WiFi Connected  ");
      beepOnce();
      delay(1500);
  } else {
      lcd.setCursor(0, 1);
      lcd.print("WiFi Failed     ");
      beepAlert();
      while(true) delay(1000);
  }

  // -------- GOOGLE CONNECTION --------
  lcd.setCursor(0, 2);
  lcd.print("Connecting Google");

  client = new HTTPSRedirect(httpsPort);
  client->setInsecure();
  client->setPrintResponseBody(true);
  client->setContentTypeHeader("application/json");

  bool flag = false;
  for (int i = 0; i < 5; i++) {
    if (client->connect(host, httpsPort)) {
      flag = true;
      break;
    }
    delay(1000);
  }

  if (flag) {
    lcd.setCursor(0, 3);
    lcd.print("Google Connected");
    beepTwice();
    delay(1500);
  } else {
    lcd.setCursor(0, 3);
    lcd.print("Google Failed");
    beepAlert();
    return;
  }

  // Show scan screen
  showScanScreen();
  beepOnce();
  delay(2000);
}

// ---------------- LOOP ----------------
void loop() {
  if (!mfrc522.PICC_IsNewCardPresent()) return;
  if (!mfrc522.PICC_ReadCardSerial()) return;

  beepOnce();

  String values = "", data;
  bool isAuthorized = true; // assume authorized until proven otherwise

  for (byte i = 0; i < total_blocks; i++) {
    memset(readBlockData, 0, sizeof(readBlockData));
    ReadDataFromBlock(blocks[i], readBlockData);

    data = String((char*)readBlockData);
    data.trim();

    // If any block is empty, consider the card unauthorized
    if (data.length() == 0) {
      isAuthorized = false;
      break;
    }

    if (i == 0) {
      student_id = data;
      values = "\"" + data + ",";
    }
    else if (i == 1) {
      student_name = data;
      values += data + ",";
    }
    else if (i == 2) {
      father_name = data;
      values += data + ",";
    }
    else if (i == 3) {
      values += data + ",";
    }
    else if (i == 4) {
      student_class = data;
      values += data + "\"}";
    }
  }

  lcd.clear();
  if (!isAuthorized) {
    // Show Unauthorized card
    lcd.setCursor(1, 1);
    lcd.print("Unauthorized Card");
    lcd.setCursor(9, 2);
    lcd.write(byte(1)); // sad face
    beepAlert();
  } else {
    // Post to Google Sheets
    payload = payload_base + values;

    lcd.setCursor(0, 0);
    lcd.print("Publishing...");
    lcd.setCursor(0, 1);
    lcd.print("Please Wait");

    if (client->POST(url, host, payload)) {

      serverResponse = client->getResponseBody();
      Serial.println(serverResponse);

      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Reg No: ");
      lcd.print(student_id);

      lcd.setCursor(0, 1);
      lcd.print("Name: ");
      lcd.print(student_name);

      lcd.setCursor(0, 2);
      lcd.print("Class: ");
      lcd.print(student_class);

      lcd.setCursor(0, 3);
      lcd.print("Attendance Marked");

      beepTwice();

    } else {
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Upload Failed!");
      lcd.setCursor(0, 1);
      lcd.print("Check Internet");
      beepAlert();
    }
  }

  delay(5000);
  showScanScreen();

  mfrc522.PICC_HaltA();
  mfrc522.PCD_StopCrypto1();
}

